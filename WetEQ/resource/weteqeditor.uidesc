<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
	<fonts>
		<font name="TinyFont" font-name="Arial" size="0"/>
	</fonts>

	<colors>
		<color name="Transparent" rgba="#00000000"/>
	</colors>

	<control-tags>
		<control-tag name="kGainParam" tag="0"/>
		<control-tag name="kHPFParam" tag="1"/>
		<control-tag name="kLPFParam" tag="2"/>
		<control-tag name="kHFGainParam" tag="3"/>
		<control-tag name="kHFFreqParam" tag="4"/>
		<control-tag name="kHMFGainParam" tag="5"/>
		<control-tag name="kHMFFreqParam" tag="6"/>
		<control-tag name="kLMFGainParam" tag="7"/>
		<control-tag name="kLMFFreqParam" tag="8"/>
		<control-tag name="kLFGainParam" tag="9"/>
		<control-tag name="kLFFreqParam" tag="10"/>
		<control-tag name="kInputMeterL" tag="11"/>
		<control-tag name="kInputMeterR" tag="12"/>
		<control-tag name="kOutputMeterL" tag="13"/>
		<control-tag name="kOutputMeterR" tag="14"/>
	</control-tags>

	<!-- Generated by tools/make-assets.py from the panel art.
	     Do not hand-edit: re-run the script instead, so the geometry here
	     stays tied to the measured positions of the painted controls. -->
	<template background-color="~ BlackCColor"
	          bitmap="backplate"
	          class="CViewContainer"
	          name="view"
	          size="533, 800"
	          transparent="false">

		<!-- LED meters: 12 segments, vertical, green at the bottom -->
		<view class="LEDMeterView"
		      control-tag="kInputMeterL"
		      origin="67, 108"
		      size="25, 226"
		      num-segments="12"
		      segment-gap="6"
		      horizontal="false"
		      db-min="-48"
		      db-max="18"
		      transparent="false"/>

		<view class="LEDMeterView"
		      control-tag="kInputMeterR"
		      origin="98, 108"
		      size="25, 226"
		      num-segments="12"
		      segment-gap="6"
		      horizontal="false"
		      db-min="-48"
		      db-max="18"
		      transparent="false"/>

		<view class="LEDMeterView"
		      control-tag="kOutputMeterL"
		      origin="151, 108"
		      size="25, 226"
		      num-segments="12"
		      segment-gap="6"
		      horizontal="false"
		      db-min="-48"
		      db-max="18"
		      transparent="false"/>

		<view class="LEDMeterView"
		      control-tag="kOutputMeterR"
		      origin="182, 108"
		      size="25, 226"
		      num-segments="12"
		      segment-gap="6"
		      horizontal="false"
		      db-min="-48"
		      db-max="18"
		      transparent="false"/>

		<!-- Stepped knobs. One filmstrip frame per FINE step, so the frame
		     index is the step index. The knob rests on every
		     coarse-step-th of them; Shift reaches the rest.
		     Mouse wheel up = clockwise. -->
		<view class="SteppedKnob"
		      control-tag="kHFGainParam"
		      origin="281, 113"
		      size="83, 83"
		      bitmap="knob_hf_gain"
		      step-count="65"
		      coarse-step="4"
		      transparent="true"/>

		<view class="SteppedKnob"
		      control-tag="kHFFreqParam"
		      origin="412, 115"
		      size="80, 80"
		      bitmap="knob_hf_freq"
		      step-count="65"
		      coarse-step="4"
		      transparent="true"/>

		<view class="SteppedKnob"
		      control-tag="kHMFGainParam"
		      origin="279, 296"
		      size="84, 84"
		      bitmap="knob_hmf_gain"
		      step-count="65"
		      coarse-step="4"
		      transparent="true"/>

		<view class="SteppedKnob"
		      control-tag="kHMFFreqParam"
		      origin="409, 295"
		      size="85, 85"
		      bitmap="knob_hmf_freq"
		      step-count="65"
		      coarse-step="4"
		      transparent="true"/>

		<view class="SteppedKnob"
		      control-tag="kGainParam"
		      origin="78, 413"
		      size="104, 104"
		      bitmap="knob_gain"
		      step-count="65"
		      coarse-step="4"
		      transparent="true"/>

		<view class="SteppedKnob"
		      control-tag="kLMFGainParam"
		      origin="281, 480"
		      size="82, 82"
		      bitmap="knob_lmf_gain"
		      step-count="65"
		      coarse-step="4"
		      transparent="true"/>

		<view class="SteppedKnob"
		      control-tag="kLMFFreqParam"
		      origin="412, 479"
		      size="81, 81"
		      bitmap="knob_lmf_freq"
		      step-count="65"
		      coarse-step="4"
		      transparent="true"/>

		<view class="SteppedKnob"
		      control-tag="kHPFParam"
		      origin="31, 607"
		      size="82, 82"
		      bitmap="knob_hpf"
		      step-count="65"
		      coarse-step="4"
		      transparent="true"/>

		<view class="SteppedKnob"
		      control-tag="kLPFParam"
		      origin="146, 607"
		      size="82, 82"
		      bitmap="knob_lpf"
		      step-count="65"
		      coarse-step="4"
		      transparent="true"/>

		<view class="SteppedKnob"
		      control-tag="kLFGainParam"
		      origin="283, 653"
		      size="81, 81"
		      bitmap="knob_lf_gain"
		      step-count="65"
		      coarse-step="4"
		      transparent="true"/>

		<view class="SteppedKnob"
		      control-tag="kLFFreqParam"
		      origin="412, 653"
		      size="81, 81"
		      bitmap="knob_lf_freq"
		      step-count="65"
		      coarse-step="4"
		      transparent="true"/>

	</template>

	<custom>
		<attributes name="FocusDrawing"/>
		<attributes Path="weteqeditor.uidesc" name="VST3Editor"/>
	</custom>

	<bitmaps>
		<bitmap name="backplate" path="backplate.png"/>
		<bitmap name="knob_hf_gain" path="knob_hf_gain.png"
		        multiframe-size="83, 83"
		        multiframe-num-frames="65"
		        mulitframe-frames-per-row="1"/>
		<bitmap name="knob_hf_freq" path="knob_hf_freq.png"
		        multiframe-size="80, 80"
		        multiframe-num-frames="65"
		        mulitframe-frames-per-row="1"/>
		<bitmap name="knob_hmf_gain" path="knob_hmf_gain.png"
		        multiframe-size="84, 84"
		        multiframe-num-frames="65"
		        mulitframe-frames-per-row="1"/>
		<bitmap name="knob_hmf_freq" path="knob_hmf_freq.png"
		        multiframe-size="85, 85"
		        multiframe-num-frames="65"
		        mulitframe-frames-per-row="1"/>
		<bitmap name="knob_gain" path="knob_gain.png"
		        multiframe-size="104, 104"
		        multiframe-num-frames="65"
		        mulitframe-frames-per-row="1"/>
		<bitmap name="knob_lmf_gain" path="knob_lmf_gain.png"
		        multiframe-size="82, 82"
		        multiframe-num-frames="65"
		        mulitframe-frames-per-row="1"/>
		<bitmap name="knob_lmf_freq" path="knob_lmf_freq.png"
		        multiframe-size="81, 81"
		        multiframe-num-frames="65"
		        mulitframe-frames-per-row="1"/>
		<bitmap name="knob_hpf" path="knob_hpf.png"
		        multiframe-size="82, 82"
		        multiframe-num-frames="65"
		        mulitframe-frames-per-row="1"/>
		<bitmap name="knob_lpf" path="knob_lpf.png"
		        multiframe-size="82, 82"
		        multiframe-num-frames="65"
		        mulitframe-frames-per-row="1"/>
		<bitmap name="knob_lf_gain" path="knob_lf_gain.png"
		        multiframe-size="81, 81"
		        multiframe-num-frames="65"
		        mulitframe-frames-per-row="1"/>
		<bitmap name="knob_lf_freq" path="knob_lf_freq.png"
		        multiframe-size="81, 81"
		        multiframe-num-frames="65"
		        mulitframe-frames-per-row="1"/>
	</bitmaps>
</vstgui-ui-description>
